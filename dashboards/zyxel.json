      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(zyxel_port_up{job=~\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
